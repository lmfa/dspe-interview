@page "/questions/list"

@inject QuestionService QuestionService

<h3>All Questions</h3>

@if (!_loaded)
{
    <p>Loading questions...</p>
}
else if (!_questions.Any())
{
    <p>No questions found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Topic</th>
                <th>Seniority</th>
                <th>Technologies</th>
                <th>Question</th>
                <th>Suggested Answer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in _questions)
            {
                <tr>
                    <td>@q.Id</td>
                    <td>@q.TopicName</td>
                    <td>@q.SeniorityLevelName</td>
                    <td>@TechnologiesToString(q.Technologies)</td>
                    <td>@Truncate(q.QuestionText, 120)</td>
                    <td>@Truncate(q.SuggestedAnswer, 120)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loaded;
    private List<QuestionDto> _questions = new();

    protected override async Task OnInitializedAsync()
    {
        _questions = await QuestionService.GetQuestionsAsync();
        _loaded = true;
    }

    private static string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        if (value.Length <= maxLength)
            return value;

        return value.Substring(0, maxLength) + "...";
    }

    private static string TechnologiesToString(List<string> technologies)
    {
        if (technologies == null || !technologies.Any())
            return string.Empty;
        return string.Join(", ", technologies.Select(t => t));
    }
}
