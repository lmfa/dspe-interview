@page "/candidates"

@inject CandidateService CandidateService

<h3>Candidates</h3>

@if (_candidates == null)
{
    <p>Loading...</p>
}
else if (_candidates.Count == 0)
{
    <p>No candidates found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var candidate in _candidates)
            {
                <tr>
                    <td>@candidate.Id</td>
                    <td>@candidate.Name</td>
                </tr>
            }

        </tbody>
    </table>
}

@code {

    private List<CandidateDto>? _candidates;

    protected override async Task OnInitializedAsync()
    {
        _candidates = await CandidateService.GetCandidatesAsync();
    }
}