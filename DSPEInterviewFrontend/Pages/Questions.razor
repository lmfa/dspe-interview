@page "/questions"

@inject QuestionService QuestionService

<h3>Add Interview Question</h3>

@if (!_loaded)
{
    <p>Loading data...</p>
}
else
{
    <div class="mb-3">

        <label class="form-label">
            Seniority Level
        </label>

        <InputSelect class="form-select"
                     @bind-Value="_question.SeniorityLevelId">

            @foreach (var level in _levels)
            {
                <option value="@level.Id">
                    @level.Name
                </option>
            }

        </InputSelect>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Topic
        </label>

        <InputSelect class="form-select"
                     @bind-Value="_question.TopicId">

            @foreach (var topic in _topics)
            {
                <option value="@topic.Id">
                    @topic.Name
                </option>
            }

        </InputSelect>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Technologies
        </label>

        @foreach (var technology in _technologies)
        {
            <div class="form-check">

                <input class="form-check-input"
                       type="checkbox"
                       @bind="technology.Selected" />

                <label class="form-check-label">
                    @technology.Name
                </label>

            </div>
        }

    </div>

    <div class="mb-3">

        <label class="form-label">
            Question
        </label>

        <InputTextArea class="form-control"
                       rows="4"
                       @bind-Value="_question.QuestionText" />

    </div>

    <div class="mb-3">

        <label class="form-label">
            Suggested Answer
        </label>

        <InputTextArea class="form-control"
                       rows="8"
                       @bind-Value="_question.SuggestedAnswer" />

    </div>

    <button class="btn btn-primary"
            @onclick="SaveQuestion">

        Save

    </button>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success mt-3">
            @_message
        </div>
    }
}

@code {

    private bool _loaded;

    private string _message = string.Empty;

    private CreateQuestionDto _question = new();

    private List<QuestionTopicDto> _topics = [];

    private List<SeniorityLevelDto> _levels = [];

    private List<TechnologyDto> _technologies = [];

    protected override async Task OnInitializedAsync()
    {
        _topics =
            await QuestionService.GetTopicsAsync();

        _levels =
            await QuestionService.GetSeniorityLevelsAsync();

        _technologies =
            await QuestionService.GetTechnologiesAsync();

        if (_levels.Any())
            _question.SeniorityLevelId = _levels.First().Id;

        if (_topics.Any())
            _question.TopicId = _topics.First().Id;

        _loaded = true;
    }

    private async Task SaveQuestion()
    {
        _question.TechnologyIds =
            _technologies
                .Where(t => t.Selected)
                .Select(t => t.Id)
                .ToList();

        await QuestionService.CreateQuestionAsync(
            _question);

        _message = "Question saved successfully.";

        _question = new CreateQuestionDto
        {
            SeniorityLevelId = _levels.First().Id,
            TopicId = _topics.First().Id
        };

        foreach (var technology in _technologies)
        {
            technology.Selected = false;
        }
    }
}