@page "/interview"

@inject QuestionService QuestionService
@inject CandidateService CandidateService

<h3>Interview</h3>

@if (!_loaded)
{
    <p>Loading data...</p>
}
else
{
    <div class="mb-3">
        <label class="form-label">Select a candidate</label>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <select class="form-select" @bind="_selectedCandidateId">
                <option value="">-- Select Candidate --</option>
                @foreach (var candidate in _candidates)
                {
                    <option value="@candidate.Id">@candidate.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Select technology and seniority</label>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <select class="form-select" @onchange="HandleTechnologyChange">
                <option value="">-- Select Technology --</option>
                @foreach (var tech in _technologies)
                {
                    <option value="@tech.Id" selected="@(_selectedTechnologyId == tech.Id.ToString())">@tech.Name</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <select class="form-select" @bind="_selectedSeniorityLevelId">
                <option value="">-- Select Seniority Level --</option>
                @foreach (var level in _seniorityLevels)
                {
                    <option value="@level.Id">@level.Name</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <button class="btn btn-primary" 
                    disabled="@(string.IsNullOrEmpty(_selectedTechnologyId) || string.IsNullOrEmpty(_selectedSeniorityLevelId))" 
                    @onclick="Generate">Generate</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_selectedTechnologyId))
    {
        <div class="mb-3">
            <label class="form-label">Choose Topics to include in the interview</label>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                <div class="border p-3 bg-light">
                    @if (!_topics.Any())
                    {
                        <p>No topics available for the selected technology.</p>
                    }
                    else
                    {
                        @foreach (var topic in _topics)
                        {
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       id="topic_@topic.Id"
                                       @bind="topic.Selected" />
                                <label class="form-check-label" for="topic_@topic.Id">
                                    @topic.Name
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info mt-3">
            @_message
        </div>
    }

    @if (_generatedQuestions.Any())
    {
        <div class="mt-5">
            <h4>Generated Interview Questions</h4>
            @foreach (var topicGroup in _generatedQuestions.GroupBy(q => q.TopicName))
            {
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-primary mb-0">@topicGroup.Key</h5>
                        <button class="btn btn-sm btn-outline-primary" 
                                @onclick="@(() => ToggleManualAddDropdown(topicGroup.Key))">
                            Add/Remove Question
                        </button>
                    </div>

                    @if (_openDropdownTopic == topicGroup.Key)
                    {
                        <div class="border p-3 bg-light mb-3">
                            @{
                                var allTopicQuestions = GetAllQuestionsForTopic(topicGroup.Key);
                                if (allTopicQuestions.Any())
                                {
                                    @foreach (var q in allTopicQuestions)
                                    {
                                        bool isSelected = topicGroup.Any(tq => tq.Id == q.Id);
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="addquestion_@q.Id"
                                                   checked="@isSelected"
                                                   @onchange="@((ChangeEventArgs e) => HandleManualAddQuestion(q, (bool)e.Value, topicGroup.Key))" />
                                            <label class="form-check-label" for="addquestion_@q.Id">
                                                @q.QuestionText.Substring(0, Math.Min(80, q.QuestionText.Length))...
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>No other questions available for this topic.</p>
                                }
                            }
                        </div>
                    }

                    @foreach (var question in topicGroup)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">Question @question.Id</h6>
                                <p class="card-text"><strong>Question:</strong> @question.QuestionText</p>
                                <p class="card-text"><strong>Suggested answer:</strong> @question.SuggestedAnswer</p>

                                <div class="mb-3">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <label class="form-label"><strong>Candidate response</strong></label>
                                            <textarea class="form-control" 
                                                      rows="4"
                                                      placeholder="Enter candidate's response here..."
                                                      @bind="@_candidateResponses[question.Id]"
                                                      @bind:event="oninput">
                                            </textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label"><strong>Candidate Rate</strong></label>
                                            <select class="form-select" @bind="@_candidateRatings[question.Id]">
                                                <option value="">-- Select Rating --</option>
                                                <option value="0">0</option>
                                                <option value="1">1</option>
                                                <option value="2">2</option>
                                                <option value="3">3</option>
                                                <option value="4">4</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <small class="text-muted">Seniority: @question.SeniorityLevelName</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mt-5 mb-5">
            <div class="row">
                <div class="col-md-12">
                    <button class="btn btn-primary me-2" @onclick="SaveInterview">Save Interview</button>
                    <button class="btn btn-primary">Export Interview</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool _loaded;
    private List<CandidateDto> _candidates = new();
    private List<TechnologyDto> _technologies = new();
    private List<SeniorityLevelDto> _seniorityLevels = new();
    private List<QuestionTopicDto> _topics = new();
    private List<QuestionDto> _generatedQuestions = new();
    private List<QuestionDto> _allMatchingQuestions = new();
    private Dictionary<long, string> _candidateResponses = new();
    private Dictionary<long, string> _candidateRatings = new();
    private string _selectedCandidateId = string.Empty;
    private string _selectedTechnologyId = string.Empty;
    private string _selectedSeniorityLevelId = string.Empty;
    private string _message = string.Empty;
    private string _openDropdownTopic = string.Empty;
    private readonly Random _random = new Random();

    protected override async Task OnInitializedAsync()
    {
        _candidates = await CandidateService.GetCandidatesAsync();
        _technologies = await QuestionService.GetTechnologiesAsync();
        _seniorityLevels = await QuestionService.GetSeniorityLevelsAsync();
        _loaded = true;
    }

    private async Task HandleTechnologyChange(ChangeEventArgs e)
    {
        _selectedTechnologyId = e.Value?.ToString() ?? string.Empty;
        await OnTechnologyChanged();
    }

    private async Task OnTechnologyChanged()
    {
        if (!string.IsNullOrEmpty(_selectedTechnologyId) && long.TryParse(_selectedTechnologyId, out var technologyId))
        {
            _topics = await QuestionService.GetTopicsByTechnologyAsync(technologyId);
            _message = string.Empty;
            _generatedQuestions = new();
            _allMatchingQuestions = new();
        }
        else
        {
            _topics = new();
            _generatedQuestions = new();
            _allMatchingQuestions = new();
        }
    }

    private async Task Generate()
    {
        if (string.IsNullOrEmpty(_selectedTechnologyId) || string.IsNullOrEmpty(_selectedSeniorityLevelId))
        {
            _message = "Please select both technology and seniority level.";
            return;
        }

        var selectedTopicIds = _topics
            .Where(t => t.Selected)
            .Select(t => t.Id)
            .ToList();

        if (!selectedTopicIds.Any())
        {
            _message = "Please select at least one topic.";
            return;
        }

        if (!long.TryParse(_selectedTechnologyId, out var technologyId) || !long.TryParse(_selectedSeniorityLevelId, out var seniorityLevelId))
        {
            _message = "Invalid selection.";
            return;
        }

        // Fetch questions matching the filters
        _allMatchingQuestions = await QuestionService.GetQuestionsByFiltersAsync(technologyId, selectedTopicIds, seniorityLevelId);

        // Select up to 2 questions from each topic randomly
        _generatedQuestions = _allMatchingQuestions
            .GroupBy(q => q.TopicId)
            .SelectMany(group => group.OrderBy(_ => _random.Next()).Take(2))
            .ToList();

        // Initialize candidate responses and ratings for all generated questions
        _candidateResponses = new();
        _candidateRatings = new();
        foreach (var question in _generatedQuestions)
        {
            _candidateResponses[question.Id] = string.Empty;
            _candidateRatings[question.Id] = string.Empty;
        }

        if (_generatedQuestions.Any())
        {
            _message = $"Generated {_generatedQuestions.Count} interview questions.";
        }
        else
        {
            _message = "No questions found matching the selected criteria.";
            _generatedQuestions = new();
        }

        _openDropdownTopic = string.Empty;
    }

    private void ToggleManualAddDropdown(string topicName)
    {
        _openDropdownTopic = _openDropdownTopic == topicName ? string.Empty : topicName;
    }

    private List<QuestionDto> GetAllQuestionsForTopic(string topicName)
    {
        return _allMatchingQuestions
            .Where(q => q.TopicName == topicName)
            .ToList();
    }

    private void HandleManualAddQuestion(QuestionDto question, bool isChecked, string topicName)
    {
        if (isChecked)
        {
            // Add question if not already in the list
            if (!_generatedQuestions.Any(q => q.Id == question.Id))
            {
                _generatedQuestions.Add(question);
                // Initialize candidate response and rating for the newly added question
                _candidateResponses[question.Id] = string.Empty;
                _candidateRatings[question.Id] = string.Empty;
            }
        }
        else
        {
            // Remove question
            _generatedQuestions.RemoveAll(q => q.Id == question.Id);
            // Remove candidate response and rating for the removed question
            _candidateResponses.Remove(question.Id);
            _candidateRatings.Remove(question.Id);
        }

        // Close the dropdown
        _openDropdownTopic = string.Empty;
    }

    private string GetOrCreateCandidateResponse(long questionId)
    {
        if (!_candidateResponses.ContainsKey(questionId))
        {
            _candidateResponses[questionId] = string.Empty;
        }
        return _candidateResponses[questionId];
    }

    private void SetCandidateResponse(long questionId, string response)
    {
        _candidateResponses[questionId] = response;
    }

    private async Task SaveInterview()
    {
        if (string.IsNullOrEmpty(_selectedCandidateId))
        {
            _message = "Please select a candidate.";
            return;
        }

        if (!_generatedQuestions.Any())
        {
            _message = "No questions to save.";
            return;
        }

        if (!long.TryParse(_selectedCandidateId, out var candidateId) ||
            !long.TryParse(_selectedTechnologyId, out var technologyId) ||
            !long.TryParse(_selectedSeniorityLevelId, out var seniorityLevelId))
        {
            _message = "Invalid selections.";
            return;
        }

        // Build the DTO to send to the backend
        var interviewQuestions = new List<InterviewQuestionResultDto>();
        foreach (var question in _generatedQuestions)
        {
            var response = _candidateResponses.ContainsKey(question.Id) ? _candidateResponses[question.Id] : string.Empty;
            var ratingStr = _candidateRatings.ContainsKey(question.Id) ? _candidateRatings[question.Id] : "0";

            if (!int.TryParse(ratingStr, out var rating))
            {
                rating = 0;
            }

            interviewQuestions.Add(new InterviewQuestionResultDto
            {
                QuestionId = question.Id,
                TopicId = question.TopicId,
                CandidateResponse = response,
                CandidateRating = rating
            });
        }

        var saveDto = new SaveInterviewResultDto
        {
            CandidateId = candidateId,
            TechnologyId = technologyId,
            SeniorityLevelId = seniorityLevelId,
            Questions = interviewQuestions
        };

        try
        {
            var result = await QuestionService.SaveInterviewResultAsync(saveDto);
            _message = $"Interview saved successfully with ID: {result.Id}";
        }
        catch (Exception ex)
        {
            _message = $"Error saving interview: {ex.Message}";
        }
    }
}
